# قيم توضيحية فقط. لا تضع مفاتيح حقيقية في GitHub.
# هذه المتغيرات للخادم فقط (server/) ولا تُضمَّن في كود الواجهة أو الـ APK.
PORT=8787
# أصول مسموحة مفصولة بفاصلة: التطوير + تطبيق Android + موقعك المنشور
ALLOWED_ORIGIN=http://localhost:5173,https://localhost
EGX_DATA_API_KEY=
GOLD_DATA_API_KEY=
FX_DATA_API_KEY=
FUNDS_DATA_API_KEY=
BANK_PRODUCTS_DATA_API_KEY=
ECONOMIC_DATA_API_KEY=
NEWS_API_KEY=
# اختياري (لم يُفعَّل بعد في الكود الحالي)
DATABASE_URL=
REDIS_URL=

# جلب أسعار الذهب من صفحة آي صاغة العامة (بدون إذن كتابي منهم؛ مسؤوليتك). true لتفعيله.
ISAGHA_SCRAPE_ENABLED=false
# بريد/رابط تواصل يظهر في User-Agent ليتمكنوا من مراسلتك
SCRAPER_CONTACT=

# أسعار وثائق الصناديق من صفحات SNDUK العامة (بدون إذن كتابي منهم؛ مسؤوليتك). true لتفعيله.
SNDUK_ENABLED=false
